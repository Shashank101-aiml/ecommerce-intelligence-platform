# Copy this file to .env and adjust values. Never commit the real .env file.

# --- Warehouse database (the "ecommerce" DB, separate from Airflow's own metadata DB) ---
# Host port is 5433, not 5432, because docker-compose.yml maps it that way
# to avoid clashing with a locally installed Postgres service. This only
# matters for scripts/dashboard run directly on the host; containers
# talk to each other over the internal "postgres:5432" address.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ecommerce
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# Full SQLAlchemy URL used by src/db/connection.py (built from the vars above if unset)
DATABASE_URL=postgresql+psycopg2://airflow:airflow@localhost:5433/ecommerce

# --- Dataset source ---
UCI_ONLINE_RETAIL_URL=https://archive.ics.uci.edu/ml/machine-learning-databases/00352/Online%20Retail.xlsx

# --- Airflow (used only inside docker-compose) ---
AIRFLOW_UID=50000
